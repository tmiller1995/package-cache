# Copy to .env on the VPS (chmod 600). Never commit the real file.

# Strong random password for the local Postgres (only reachable on the
# compose network). Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Token for the *new* OVH tunnel (Cloudflare Zero Trust -> Networks ->
# Tunnels -> package-cache-ovh -> Docker install command, the value after
# --token). Not the Railway tunnel's token.
TUNNEL_TOKEN=

# Where Nexus blobs and Postgres data live on the host. Keep it on the system
# disk so OVH's included daily backup covers it.
DATA_DIR=/srv/package-cache-data

# Memory, sized for VPS-3 (12 GB). For VPS-2 (8 GB) use NEXUS_HEAP=2703m,
# NEXUS_DIRECT_MEMORY=1g, PG_SHARED_BUFFERS=512MB, PG_EFFECTIVE_CACHE_SIZE=2GB.
NEXUS_HEAP=4g
NEXUS_DIRECT_MEMORY=2g
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
